[node name="SlugContainer" type="HBoxContainer" parent="MarginContainer/VBoxContainer" unique_id=1302088140]
layout_mode = 2
tooltip_text = "The Lospec slug is the URL name of a palette. Must be 16 colours.

For an example, the \"Sweetie 16\" palette URL on Lospec is:
https://lospec.com/palette-list/sweetie-16

The slug is the last part, \"sweetie-16\".
The program will attempt to make the input into the format, so inputting
\"Sweetie 16\" would also work for this palette."
alignment = 1

